# ===== 데이터베이스 (필수) =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nadife?schema=public"

# 공유 카드 절대 URL (배포 시 변경)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ===== AI 제공자 선택 =====
# "openai" (OpenAI API)   또는   "local" (사내 LLM 서버, stream-it 등)
# 빈 값은 openai로 간주.
AI_PROVIDER="openai"

# ----- OpenAI -----
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ----- Local LLM (stream-it 같은 OpenAI-호환 게이트웨이) -----
# POST <URL>  with headers X-API-Key / X-Secret-Key
# body: { message, system_prompt?, model?, temperature? }
LOCAL_LLM_URL="http://localhost:8000/api/chat"
LOCAL_LLM_API_KEY="jk-..."
LOCAL_LLM_SECRET_KEY="sk-..."
LOCAL_LLM_MODEL="exaone3.5:32b"
LOCAL_LLM_TIMEOUT_MS="60000"

# ===== AI 페르소나 자동 시드 =====
# /home, /meet 접속 시 백그라운드로 10~100명 자동 생성
# SEED_AUTO=off 로 두면 자동 시드 비활성화
# SEED_SECRET 미설정 시 localhost에서만 /api/seed/daily 호출 허용
SEED_AUTO=""
SEED_SECRET=""

# ===== 카카오톡 공유 (선택) =====
# https://developers.kakao.com 에서 앱 등록 → JavaScript 키 + 플랫폼에 도메인 추가
# 미설정 시 카카오톡 버튼은 "링크복사 + 안내"로 우회 동작
NEXT_PUBLIC_KAKAO_JS_KEY=""

# ===== 개발 옵션 =====
# 우연의 시간 — 정해진 시각 무관하게 항상 열림 (테스트용)
COINCIDENCE_ALWAYS_OPEN=""
